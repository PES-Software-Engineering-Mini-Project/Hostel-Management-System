# Copy this file to .env for local use. Do not commit the copied file.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite is the default local database; no database variables are needed.
# To use PostgreSQL, uncomment and supply all values below.
# DATABASE_ENGINE=django.db.backends.postgresql
# POSTGRES_DB=hms
# POSTGRES_USER=hms_user
# POSTGRES_PASSWORD=replace-with-a-strong-password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# A term's fee due is the allotted room's monthly fee times this many months.
# HMS_MONTHS_PER_TERM=6
